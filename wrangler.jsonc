{
  // F-Shop SaaS — Cloudflare Workers কনফিগ
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f-shop",
  "account_id": "4d64812aec0633769e58643fa48e5dae",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // public/ ফোল্ডারের CSS/JS/ছবি সরাসরি পরিবেশন হবে (সব দোকানের জন্য একই)
  "assets": { "directory": "./public", "binding": "ASSETS" },

  "vars": {
    // SaaS-এর মূল ডোমেইন
    "PLATFORM_DOMAIN": "sellxbd.com",
    "WORKER_NAME": "f-shop",
    // Cloudflare Account ID (দোকানদারের নিজের ডোমেইন ফিচারের জন্য)। CF_API_TOKEN secret হিসেবে বসে (ডিপ্লয়ের সময়)
    "CF_ACCOUNT_ID": "4d64812aec0633769e58643fa48e5dae"
  },

  // মূল ডোমেইন আর সব দোকানের subdomain এই Worker-এ আসে
  // (DNS-এ sellxbd.com আর * — দুটো proxied রেকর্ড লাগে, README দেখুন)
  "routes": [
    { "pattern": "sellxbd.com/*", "zone_name": "sellxbd.com" },
    { "pattern": "*.sellxbd.com/*", "zone_name": "sellxbd.com" }
  ],

  // মূল ডাটাবেস: দোকানের তালিকা, ডোমেইন, বিলিং
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "f-shop-platform",
      "database_id": "04f90652-1bb5-461f-b746-e7d4d1e7642d",
      "migrations_dir": "migrations/platform"
    }
  ],

  // প্রতিটা দোকান = একটা Durable Object = দোকানের নিজস্ব আলাদা SQLite ডাটাবেস
  "durable_objects": {
    "bindings": [{ "name": "SHOP", "class_name": "ShopDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShopDO"] }],

  // ছবি R2-তে নয়, প্রতিটা দোকানের নিজের ডাটাবেসে (ফ্রি প্ল্যানে চলে) — src/shop/lib/images.ts

  // .sql ফাইল কোডে টেক্সট হিসেবে আনা (দোকানের migration)
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],

  // প্রতিদিন বাংলাদেশ সময় সকাল ৬:১৭-তে: ট্রায়াল শেষ করা, মাসিক চার্জ
  // আর প্রতি ৩০ মিনিটে: অপেক্ষায় থাকা দোকানের ডোমেইন যাচাই
  "triggers": { "crons": ["17 0 * * *", "*/30 * * * *"] },

  "observability": { "enabled": true }
}
