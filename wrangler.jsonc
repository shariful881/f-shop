{
  // F-Shop SaaS — Cloudflare Workers কনফিগ
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "f-shop",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],

  // public/ ফোল্ডারের CSS/JS/ছবি সরাসরি পরিবেশন হবে (সব দোকানের জন্য একই)
  "assets": { "directory": "./public", "binding": "ASSETS" },

  "vars": {
    // SaaS-এর মূল ডোমেইন — কেনার পর এখানে বসাবেন
    "PLATFORM_DOMAIN": "ourdomain.com",
    "WORKER_NAME": "f-shop",
    // আপনার Cloudflare Account ID (নিজের ডোমেইন ফিচারের জন্য)। CF_API_TOKEN secret হিসেবে বসাবেন (README দেখুন)
    "CF_ACCOUNT_ID": ""
  },

  // মূল ডাটাবেস: দোকানের তালিকা, ডোমেইন, বিলিং
  // লাইভ করার আগে Cloudflare-এ D1 বানিয়ে database_id বদলাবেন (README দেখুন)
  "d1_databases": [
    {
      "binding": "PLATFORM_DB",
      "database_name": "f-shop-platform",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations/platform"
    }
  ],

  // প্রতিটা দোকান = একটা Durable Object = দোকানের নিজস্ব আলাদা SQLite ডাটাবেস
  "durable_objects": {
    "bindings": [{ "name": "SHOP", "class_name": "ShopDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ShopDO"] }],

  // পণ্যের ছবি (প্রতিটা দোকানের আলাদা ফোল্ডার: shops/<দোকানের আইডি>/...)
  "r2_buckets": [{ "binding": "IMAGES", "bucket_name": "f-shop-images" }],

  // .sql ফাইল কোডে টেক্সট হিসেবে আনা (দোকানের migration)
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],

  // প্রতিদিন বাংলাদেশ সময় সকাল ৬:১৭-তে: ট্রায়াল শেষ করা, মাসিক চার্জ
  // আর প্রতি ৩০ মিনিটে: অপেক্ষায় থাকা দোকানের ডোমেইন যাচাই
  "triggers": { "crons": ["17 0 * * *", "*/30 * * * *"] },

  "observability": { "enabled": true }
}
