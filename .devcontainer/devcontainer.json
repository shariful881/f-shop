{
  // GitHub Codespaces: খুললেই সব নিজে সেটআপ হবে আর সাইট port 8000-এ চালু হবে
  "name": "F-Shop",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // প্রথমবার: প্যাকেজ ইনস্টল, ডাটাবেস টেবিল বানানো, নমুনা পণ্য বসানো
  "postCreateCommand": "npm install && npm run db:migrate && npm run db:seed",

  // প্রতিবার Codespace চালু হলে: port 8000 পাবলিক করা আর সাইট চালু করা
  "postStartCommand": "gh codespace ports visibility 8000:public -c $CODESPACE_NAME || true",
  "postAttachCommand": "npm run dev",

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "F-Shop",
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": ["qwtel.sqlite-viewer"]
    }
  }
}
